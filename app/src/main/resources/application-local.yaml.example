# 복사용 틀 / application-local.yaml로 복사 후 값 채울 것 (local 파일은 커밋 금지)
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/platform
    username: platform
    password: change-me
  data:
    redis:
      host: localhost
      port: 6379
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
